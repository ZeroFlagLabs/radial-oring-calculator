  <property name="styleSheet">
   <string notr="true">
            QWidget#appSurface { background: #f3f7fb; color: #1b3452; }
            QGroupBox { background: #ffffff; border: 1px solid #d8e4f0;
                        border-radius: 6px; margin-top: 13px; padding: 5px 7px 5px;
                        font-weight: 600; color: #174675; }
            QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left;
                               left: 10px; top: 2px; padding: 0 4px; color: #164f8a; }
            QLineEdit, QDoubleSpinBox, QComboBox { background: white; border: 1px solid #b9cce1;
                       border-radius: 4px; min-height: 22px; padding: 1px 4px; color: #243d58; }
            QDoubleSpinBox:disabled { background: #e3e8ee; border-color: #c4cdd8; color: #8190a1; }
            QDoubleSpinBox::up-button:disabled, QDoubleSpinBox::down-button:disabled {
                       background: #dce2e9; }
            QDoubleSpinBox:focus, QComboBox:focus { border: 2px solid #258aca; }
            QPushButton { background: #eaf3fc; color: #144b83; border: 1px solid #9ebfe2;
                          border-radius: 5px; min-height: 24px; padding: 2px 8px; font-weight: 600; }
            QPushButton:hover { background: #d9ecff; }
            QPushButton:disabled { color: #8795a5; background: #eff2f5; }
            QPlainTextEdit { background: white; color: #243d58; }

            /* Small, borderless steppers matching the outlined dropdown chevron. */
            QDoubleSpinBox { padding-right: 18px; }
            QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
                subcontrol-origin: border;
                width: 16px;
                background: transparent;
                border: none;
            }
            QDoubleSpinBox::up-button { subcontrol-position: top right; }
            QDoubleSpinBox::down-button { subcontrol-position: bottom right; }
            QDoubleSpinBox::up-arrow {
                image: url(src/resources/icons/spin-chevron-up.png);
                width: 12px; height: 8px;
            }
            QDoubleSpinBox::down-arrow {
                image: url(src/resources/icons/spin-chevron-down.png);
                width: 12px; height: 8px;
            }
            QDoubleSpinBox::up-arrow:disabled {
                image: url(src/resources/icons/spin-chevron-up-disabled.png);
            }
            QDoubleSpinBox::down-arrow:disabled {
                image: url(src/resources/icons/spin-chevron-down-disabled.png);
            }
            QPushButton#guide_button {
                background: #f7fafc;
                border: 1px solid #c1d4e8;
                border-radius: 5px;
                min-height: 0px;
                padding: 0px;
            }
            QPushButton#guide_button:hover {
                background: #e5f1fc;
                border-color: #80b0dd;
            }
</string>
