     <widget class="QWidget" name="references_tab">
      <attribute name="title">
       <string>References</string>
      </attribute>
      <layout class="QVBoxLayout" name="referencesLayout">
       <item>
        <widget class="QScrollArea" name="references_scroll">
         <property name="widgetResizable"><bool>true</bool></property>
         <property name="frameShape"><enum>QFrame::Shape::NoFrame</enum></property>
         <widget class="QWidget" name="references_content">
          <layout class="QVBoxLayout" name="referencesContentLayout">
           <property name="leftMargin"><number>3</number></property>
           <property name="rightMargin"><number>3</number></property>
           <property name="topMargin"><number>3</number></property>
           <property name="bottomMargin"><number>3</number></property>
           <item>
            <widget class="QLabel" name="references_heading">
             <property name="text"><string>Reference publications</string></property>
             <property name="styleSheet"><string>font-weight:600; color:#164f8a;</string></property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="references_text">
             <property name="textFormat"><enum>Qt::TextFormat::RichText</enum></property>
             <property name="text"><string>&lt;html&gt;&lt;body&gt;
&lt;p style="margin:0 0 10px 0;"&gt;The following publications were used to develop and verify the calculator's dimensional screening methods:&lt;/p&gt;
&lt;p style="margin:0 0 10px 0;"&gt;• Parker Hannifin: Parker O-Ring Handbook, Catalog ORD 5700A/US (2001), Sections 3.5–3.7 and Figure 3-3. Guidance on O-ring stretch, squeeze, gland fill and installed cross-section reduction.&lt;/p&gt;
&lt;p style="margin:0 0 10px 0;"&gt;• Freudenberg Sealing Technologies: O-Ring Reference AS568 Sizes, pages 2–4. O-ring dimensions, tolerances and radial groove design guidance.&lt;/p&gt;
&lt;p style="margin:0 0 10px 0;"&gt;• James Walker: 'O' Ring Guide, Issue 7, pages 27–31. Supplementary O-ring housing and design guidance.&lt;/p&gt;
&lt;/body&gt;&lt;/html&gt;</string></property>
             <property name="wordWrap"><bool>true</bool></property>
            </widget>
           </item>
           <item><spacer name="referencesSectionGap"><property name="orientation"><enum>Qt::Orientation::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item><item>
            <widget class="QLabel" name="criteria_heading">
             <property name="text"><string>Adopted dimensional screening criteria</string></property>
             <property name="styleSheet"><string>font-weight:600; color:#164f8a;</string></property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="criteria_text">
             <property name="textFormat"><enum>Qt::TextFormat::RichText</enum></property>
             <property name="text"><string>&lt;html&gt;&lt;body&gt;
&lt;p style="margin:0 0 10px 0;"&gt;The following limits are applied by the calculator:&lt;/p&gt;
&lt;p style="margin:0 0 10px 0;"&gt;• O-ring squeeze: Minimum ≥ 0.007″; maximum ≤ 30% for static applications or ≤ 16% for dynamic (reciprocating) applications. Based on Parker, Section 3.6.&lt;/p&gt;
&lt;p style="margin:0 0 10px 0;"&gt;• O-ring fit: Installed ID stretch of 0–5% for piston grooves, or OD interference of 0–2% for cylinder grooves. Based on Parker, Section 3.5, and Freudenberg, page 2.&lt;/p&gt;
&lt;p style="margin:0 0 10px 0;"&gt;• Gland fill: 60–85%, with approximately 75% as the preferred target. Based on Parker, Section 3.7.&lt;/p&gt;
&lt;/body&gt;&lt;/html&gt;</string></property>
             <property name="wordWrap"><bool>true</bool></property>
            </widget>
           </item>
           <item><spacer name="referencesClosingNoteGap"><property name="orientation"><enum>Qt::Orientation::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
           <item>
            <widget class="QLabel" name="references_note">
             <property name="text"><string>These are selected general dimensional screening criteria, not universal acceptance limits for all materials and operating conditions. Manufacturer recommendations may differ for specific applications.

The reference publications are not distributed with the application.</string></property>
             <property name="wordWrap"><bool>true</bool></property>
            </widget>
           </item>
           <item>
            <spacer name="referencesSpacer">
             <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
             <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
             <property name="sizeHint" stdset="0"><size><width>20</width><height>0</height></size></property>
            </spacer>
           </item>
          </layout>
          <property name="styleSheet"><string>QWidget#references_content { background: white; }</string></property>
         </widget>
         <property name="styleSheet"><string>QScrollArea#references_scroll { background: white; border: none; } QScrollArea#references_scroll &gt; QWidget &gt; QWidget { background: white; }</string></property>
        </widget>
       </item>
      </layout>
